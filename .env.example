# Copy values into your shell, or a LOCAL .env file (never commit secrets).
# The CLI deliberately does not load .env automatically.
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=REPLACE_WITH_REAL_COMPANY_UUID
# Authenticated deployments require a scoped bearer token.
PAPERCLIP_TOKEN=
# Optional agent IDs; leave empty to create an unassigned task.
PAPERCLIP_AGENT_ARCHITECT_ID=
PAPERCLIP_AGENT_DEVELOPER_ID=
PAPERCLIP_AGENT_REVIEWER_ID=
PAPERCLIP_AGENT_QA_ID=
PAPERCLIP_AGENT_DEVOPS_ID=
PAPERCLIP_AGENT_DOCS_ID=
