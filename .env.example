# Примерни имена, без истински тайни; никога не commit-вай .env.
DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
SSH_CONNECTOR_TOKEN=

# Локален API помощник: празният company ID трябва да се попълни ръчно.
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=
PAPERCLIP_TOKEN=
PAPERCLIP_AGENT_ARCHITECT_ID=
PAPERCLIP_AGENT_DEVELOPER_ID=
PAPERCLIP_AGENT_DEVELOPER_CODEX_ID=
PAPERCLIP_AGENT_REVIEWER_ID=
PAPERCLIP_AGENT_QA_ID=
PAPERCLIP_AGENT_DEVOPS_ID=
PAPERCLIP_AGENT_DOCS_ID=

# Празни placeholders за Tailscale и Proxmox — попълни само в игнориран .env.
TAILSCALE_AUTHKEY=
PROXMOX_API_TOKEN=
# За фазa 2 PostgreSQL Compose; никога не попълвай парола в Git.
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
